<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/ro_chip_red" />
            <stroke android:width="1.5dp" android:color="@color/ro_brass" />
        </shape>
    </item>
    <item android:left="10dp" android:right="10dp" android:top="10dp" android:bottom="10dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="@color/ro_brass" android:dashWidth="3dp" android:dashGap="2dp" />
            <solid android:color="@color/transparent" />
        </shape>
    </item>
</layer-list>
