<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#5A1A0F" />
            <corners android:radius="8dp" />
            <stroke android:width="1.5dp" android:color="@color/ro_brass" />
        </shape>
    </item>
    <item android:left="6dp" android:right="6dp" android:top="6dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/ro_amber" />
            <solid android:color="#3A0F08" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</layer-list>
