<?xml version="1.0" encoding="utf-8"?>
<!-- Neon Pulse: dark glass with magenta/cyan rim glow. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/np_background" />
        </shape>
    </item>
    <item android:left="20dp" android:right="20dp" android:top="40dp" android:bottom="100dp">
        <shape android:shape="oval">
            <gradient
                android:type="sweep"
                android:startColor="@color/np_magenta"
                android:centerColor="@color/np_purple"
                android:endColor="@color/np_cyan" />
        </shape>
    </item>
    <item android:left="32dp" android:right="32dp" android:top="52dp" android:bottom="112dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="500"
                android:startColor="@color/np_surface_elev"
                android:endColor="@color/np_felt" />
        </shape>
    </item>
</layer-list>
