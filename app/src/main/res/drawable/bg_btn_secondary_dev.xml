<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/dev_background" />
            <stroke android:width="1.5dp" android:color="@color/dev_disabled_text" />
            <corners android:radius="0dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/dev_pressed" />
            <stroke android:width="1.5dp" android:color="@color/dev_text_primary" />
            <corners android:radius="0dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/dev_background" />
            <stroke android:width="1.5dp" android:color="@color/dev_text_primary" />
            <corners android:radius="0dp" />
        </shape>
    </item>
</selector>
