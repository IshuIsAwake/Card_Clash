<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tableRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true">

    <!-- TOP BAR -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/roomCodeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ROOM 000000"
            android:letterSpacing="0.18"
            android:textStyle="bold"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/variationPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Classic"
            android:letterSpacing="0.12"
            android:textStyle="bold"
            android:textSize="12sp"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:layout_marginStart="14dp" />

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <Button
            android:id="@+id/btnMenu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MENU" />
    </LinearLayout>

    <!-- LEFT COLUMN: opponents stacked vertically -->
    <ScrollView
        android:id="@+id/opponentScroll"
        android:layout_width="160dp"
        android:layout_height="0dp"
        android:scrollbars="none"
        android:paddingHorizontal="10dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/opponentColumn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="10dp" />
    </ScrollView>

    <!-- CENTER POT -->
    <LinearLayout
        android:id="@+id/centerPot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/handArea"
        app:layout_constraintStart_toEndOf="@id/opponentScroll"
        app:layout_constraintEnd_toStartOf="@id/actionPanel">

        <TextView
            android:id="@+id/potEyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="POT"
            android:textSize="11sp"
            android:letterSpacing="0.20"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/potAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textStyle="bold"
            android:textSize="34sp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="6dp"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/stakeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="11sp"
            android:letterSpacing="0.14"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <!-- ACTION COLUMN -->
    <LinearLayout
        android:id="@+id/actionPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnSeen"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:text="SEE"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btnChaal"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:text="CHAAL"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btnRaise"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:text="RAISE"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btnShow"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:text="SHOW"
            android:layout_marginBottom="6dp" />

        <Button
            android:id="@+id/btnFold"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:text="PACK" />
    </LinearLayout>

    <!-- LOCAL HAND AREA: cards row + identity strip -->
    <LinearLayout
        android:id="@+id/handArea"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="14dp"
        android:paddingBottom="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/opponentScroll"
        app:layout_constraintEnd_toStartOf="@id/actionPanel">

        <LinearLayout
            android:id="@+id/localCardRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <com.example.cardclash.ui.common.CardView
                android:id="@+id/myCard1"
                android:layout_width="56dp"
                android:layout_height="80dp"
                android:layout_marginEnd="6dp" />
            <com.example.cardclash.ui.common.CardView
                android:id="@+id/myCard2"
                android:layout_width="56dp"
                android:layout_height="80dp"
                android:layout_marginEnd="6dp" />
            <com.example.cardclash.ui.common.CardView
                android:id="@+id/myCard3"
                android:layout_width="56dp"
                android:layout_height="80dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/localStrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/myName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textStyle="bold"
                android:textSize="13sp"
                android:letterSpacing="0.10" />

            <com.example.cardclash.ui.common.ChipStackView
                android:id="@+id/myChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp" />

            <TextView
                android:id="@+id/turnIndicator"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text=""
                android:textStyle="bold"
                android:textSize="13sp"
                android:letterSpacing="0.10" />

            <TextView
                android:id="@+id/handLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="11sp"
                android:letterSpacing="0.10" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
