<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/tableRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true">

    <!-- TOP BAR: title left, single menu button right -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/modeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BLUFF · HOT SEAT"
            android:letterSpacing="0.16"
            android:textStyle="bold"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/ruleLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:letterSpacing="0.12"
            android:layout_marginStart="14dp" />

        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

        <Button
            android:id="@+id/btnMenu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MENU" />
    </LinearLayout>

    <!-- LEFT COLUMN: opponents stacked vertically -->
    <ScrollView
        android:id="@+id/opponentScroll"
        android:layout_width="160dp"
        android:layout_height="0dp"
        android:scrollbars="none"
        android:paddingHorizontal="10dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/opponentColumn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="10dp" />
    </ScrollView>

    <!-- CENTER PILE / CLAIM STACK -->
    <LinearLayout
        android:id="@+id/centerStack"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="20dp"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/handArea"
        app:layout_constraintStart_toEndOf="@id/opponentScroll"
        app:layout_constraintEnd_toStartOf="@id/actionColumn"
        app:layout_constraintVertical_bias="0.45">

        <TextView
            android:id="@+id/sequenceLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NO ACTIVE SEQUENCE"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.20"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp" />

        <FrameLayout
            android:id="@+id/pileStack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/pileMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="11sp"
            android:letterSpacing="0.18"
            android:layout_marginTop="10dp" />

        <TextView
            android:id="@+id/turnLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.12"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/resolution"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:layout_marginTop="6dp" />

        <HorizontalScrollView
            android:id="@+id/rankPickerScroll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingHorizontal="16dp"
            android:layout_marginTop="10dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/rankPicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            android:id="@+id/lockedRankLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="11sp"
            android:letterSpacing="0.14"
            android:layout_marginTop="6dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- HAND AREA: bottom strip between opponent column and action column -->
    <LinearLayout
        android:id="@+id/handArea"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingBottom="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/opponentScroll"
        app:layout_constraintEnd_toStartOf="@id/actionColumn">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/handCountLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text=""
                android:textSize="11sp"
                android:letterSpacing="0.10" />

            <TextView
                android:id="@+id/selectionInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="11sp"
                android:letterSpacing="0.10" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/handScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginTop="6dp">

            <LinearLayout
                android:id="@+id/handRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="14dp" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- RIGHT ACTION COLUMN — vertically centered -->
    <LinearLayout
        android:id="@+id/actionColumn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnPlay"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:text="PLAY"
            android:enabled="false"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnCallBluff"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:text="CALL BLUFF"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnSkip"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:text="PASS"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnClear"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:text="CLEAR PILE"
            android:visibility="gone" />
    </LinearLayout>

    <!-- OPEN-CALL WINDOW OVERLAY -->
    <LinearLayout
        android:id="@+id/openCallOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/openCallEyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OPEN CALL WINDOW"
            android:letterSpacing="0.20"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/openCallClaim"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="32sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:gravity="center"
            android:layout_marginTop="14dp" />

        <TextView
            android:id="@+id/openCallSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Anyone calling? Tap your name. Otherwise pass to the next player."
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp" />

        <LinearLayout
            android:id="@+id/openCallCallerRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center" />

        <Button
            android:id="@+id/btnNoCall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NO CALL — PASS"
            android:layout_marginTop="22dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
